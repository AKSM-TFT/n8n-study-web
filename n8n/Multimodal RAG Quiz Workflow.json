    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst uniqueTopics = [];\nconst map = new Map();\n\nfor (const item of items) {\n  if(!map.has(item.json.folder_id)){\n    map.set(item.json.folder_id, true);\n    uniqueTopics.push({\n      folder_id: item.json.folder_id,\n      topic_name: item.json.topic_name\n    });\n  }\n}\n\nreturn [{ json: { available_topics: uniqueTopics } }];"
      },
      "id": "494c3a52-8238-410a-9ad0-39a6f1cab16d",
      "name": "Deduplicate Topics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1072,
        1008
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "63fbf982-c7b9-423e-a4d8-a949df5c5b09",
      "name": "Respond Available Topics",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1296,
        1008
      ]
    },
    {
      "parameters": {
        "jsCode": "const message = $json.body.message || $json.body.query;\n\nconst response = await this.helpers.httpRequestWithAuthentication.call(this, 'huggingFaceApi', {\n  method: 'POST',\n  url: 'https://api-inference.huggingface.co/models/sentence-transformers/all-mpnet-base-v2',\n  body: {\n    inputs: message,\n    options: { wait_for_model: true },\n  },\n  json: true,\n});\n\nreturn [{\n  json: {\n    embedding: response,\n  },\n}];"
      },
      "id": "880b95e6-d14e-4548-bbd1-b8787756ce10",
      "name": "Embed User Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        736
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT content FROM study_vectors WHERE folder_id = $1 ORDER BY embedding <=> $2::vector LIMIT 5",
        "options": {
          "queryReplacement": "={{ [ $node[\"Webhook Trigger (Chat Input)\"].json.body.folder_id, '[' + $json.embedding.join(',') + ']' ] }}"
        }
      },
      "id": "18bc1901-ba59-43d5-8765-7a09cd233613",
      "name": "Folder Isolated Vector RPC Search",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
