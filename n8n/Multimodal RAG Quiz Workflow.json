    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\n\n// Items from 'Get Processed File IDs' have a file_id field; items from\n// 'Get Files In Topic Folder' have an id field (Drive file objects).\nconst processedIds = new Set(\n  allItems.filter(item => item.json.file_id !== undefined).map(item => item.json.file_id)\n);\n\nconst files = allItems.filter(item => item.json.id !== undefined);\n\nconst unprocessed = files.filter(item => !processedIds.has(item.json.id));\n\nif (unprocessed.length === 0) {\n  // Keep the pipeline alive: 'Check If Folder Is Empty' must still receive\n  // exactly one item (whether the folder was empty, or every file in it\n  // was already processed) so Loop Over Folders can advance.\n  return [{ json: {} }];\n}\n\nreturn unprocessed;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1632,
        352
      ],
