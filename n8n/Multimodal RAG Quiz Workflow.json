    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst contextText = items.map((item, index) => `--- CHUNK ${index + 1} ---\\n${item.json.content}`).join(\"\\n\\n\");\n\nreturn [{\n    json: {\n        user_message: $node[\"Webhook Trigger (Chat Input)\"].json.body.message,\n        folder_id: $node[\"Webhook Trigger (Chat Input)\"].json.body.folder_id,\n        context: contextText || \"No context available for this specific topic.\"\n    }\n}];"
      },
