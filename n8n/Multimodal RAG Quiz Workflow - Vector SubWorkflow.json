      "parameters": {
        "jsCode": "const item = $input.first();\nconst splitData = $(\"Split Out Files\").item.json;\n\n// 1. Get the binary buffer from n8n's internal storage\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\n\n// 2. Convert buffer to raw base64 string\nconst rawBase64 = buffer.toString('base64');\n\n// 3. Construct the full Data URL required by vision LLMs\nconst mimeType = splitData.mime_type || item.binary.data.mimeType || 'image/png';\nconst dataUrl = `data:${mimeType};base64,${rawBase64}`;\n\nreturn [{\n    json: {\n        fileName: splitData.name,\n        mimeType: splitData.mime_type,\n        fileId: splitData.id,\n        folderId: splitData.folder_id,\n        topicName: splitData.folder_name,\n        imageBase64: dataUrl // Ready to pass directly to LLM payload\n    },\n    binary: item.binary\n}];"
      },
