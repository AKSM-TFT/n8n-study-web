    {
      "parameters": {
        "method": "POST",
        "url": "https://router.huggingface.co/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "huggingFaceApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"moonshotai/Kimi-K3:together\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an advanced visual document analysis AI. Do not show any reasoning, planning, chain-of-thought, or internal analysis of any kind — output ONLY the final structured transcription, starting immediately with the document title. Transcribe all text verbatim, render math formulas using precise LaTeX ($...$), detail visual diagrams/charts, and present the output using clean, structured bold headings and bullet points. For every multiple-choice question, explicitly state the correct answer on its own line as 'Answer: X' based on any highlighting or markup shown in the image.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": [\n        {\n          \"type\": \"text\",\n          \"text\": \"Describe the contents of this study material image in complete detail based on your system instructions. Do not include any reasoning or thinking steps in your output.\"\n        },\n        {\n          \"type\": \"image_url\",\n          \"image_url\": {\n            \"url\": \"{{ $json.imageBase64 }}\"\n          }\n        }\n      ]\n    }\n  ],\n  \"max_tokens\": 3072,\n  \"temperature\": 0.2\n}",
        "options": {}
